{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(ls)",
      "Bash(find)",
      "Bash(tree:*)",
      "Bash(npm run lint)",
      "Bash(npx eslint:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run:*)",
      "Bash(./scripts/lint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(gh pr:*)",
      "Bash(mv:*)",
      "Bash(gh api:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "mcp__ide__getDiagnostics",
      "Bash(ls:*)",
      "Bash(npx next build:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(sed:*)",
      "Bash(npm test)",
      "mcp__esa-mcp-server__search_esa_posts",
      "mcp__esa-mcp-server__read_esa_multiple_posts",
      "Bash(scripts/lint:*)",
      "mcp__github-mcp-server__create_branch",
      "mcp__github-mcp-server__push_files",
      "mcp__github-mcp-server__create_pull_request",
      "Bash(git branch:*)",
      "Bash(gh issue comment:*)",
      "Skill(code-review:code-review)",
      "Skill(code-review:code-review:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws configure list-profiles:*)",
      "Read(/$HOME/.aws/**)",
      "Bash(aws sso login:*)",
      "Bash(aws s3api list-buckets:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(.env*)",
      "Write(.env*)",
      "Bash(nc:*)",
      "Bash(wget:*)",
      "Bash(mongod:*)",
      "Bash(mysql:*)",
      "Bash(psql:*)",
      "mcp__supabase__execute_sql"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          },
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/tmux-sidebar-notify.sh set-waiting-silent"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          },
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/tmux-sidebar-notify.sh set-waiting-log"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          },
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/tmux-sidebar-notify.sh set-waiting-silent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          },
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/tmux-sidebar-notify.sh clear-waiting-log End(Session)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/ccnotifier-hook.sh"
          },
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/tmux-sidebar-notify.sh clear-waiting-silent"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754114821400
  }
}
