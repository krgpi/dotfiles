{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(.env*)",
      "Edit(.env*)",
      "Bash(nc:*)",
      "Bash(wget:*)",
      "Bash(mongod:*)",
      "Bash(mysql:*)",
      "Bash(psql:*)",
      "mcp__supabase__execute_sql",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "Bash(gws gmail +send:*)",
      "Bash(gws gmail +reply:*)",
      "Bash(gws gmail +reply-all:*)",
      "Bash(gws gmail +forward:*)",
      "Bash(gws gmail users messages send:*)",
      "Bash(gws gmail users messages import:*)",
      "Bash(gws gmail users messages insert:*)",
      "Bash(gws gmail users drafts send:*)",
      "Bash(gws chat +send:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh set-waiting-silent"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh set-waiting-log"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh set-waiting-silent"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh clear-waiting-log 'End(Session)'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh reset-lock"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh clear-running"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude-marketplace/karaage-tools/tmux-sidebar-notify.sh set-running"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_name' | { read -r t; case \"$t\" in *notion-fetch|*notion-get-comments|*notion-query-database-view|*notion-search) ;; *) printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Notion書き込み操作は承認が必要です\"}}' ;; esac; }",
            "if": "mcp__plugin_Notion_notion__*"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_name' | { read -r t; case \"$t\" in *authenticate|*complete_authentication) ;; *) printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Notion書き込み操作は承認が必要です\"}}' ;; esac; }",
            "if": "mcp__claude_ai_Notion__*"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/Developer/dotfiles/claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "karaage-tools@karaage-dotfiles": true,
    "slack@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "Notion@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "notion@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "bento-slides@bento": false,
    "kagisuru-tools@ideoj": true
  },
  "extraKnownMarketplaces": {
    "bento": {
      "source": {
        "source": "github",
        "repo": "nyblnet/bento"
      }
    },
    "ideoj": {
      "source": {
        "source": "github",
        "repo": "ideoj/claude-plugins"
      }
    },
    "karaage-dotfiles": {
      "source": {
        "source": "directory",
        "path": "/Users/yuki/Developer/dotfiles/claude-marketplace"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "network": {
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ]
    },
    "excludedCommands": [
      "gh *"
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "iterm2_with_bell",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754114821400
  }
}
