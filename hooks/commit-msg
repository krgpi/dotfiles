#!/bin/bash

# Commit-msg hook to prevent committing sensitive information in commit messages
# This hook checks for sensitive words defined in .sensitive-words file

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)
SENSITIVE_WORDS_FILE="$REPO_ROOT/.sensitive-words"
MSG_FILE="$1"

if [ ! -f "$SENSITIVE_WORDS_FILE" ]; then
    echo -e "${YELLOW}Warning: .sensitive-words file not found. Skipping sensitive word check.${NC}"
    exit 0
fi

SENSITIVE_WORDS=$(grep -v '^#' "$SENSITIVE_WORDS_FILE" | grep -v '^[[:space:]]*$' | tr '\n' '|' | sed 's/|$//')

if [ -z "$SENSITIVE_WORDS" ]; then
    exit 0
fi

MATCHES=$(grep -v '^#' "$MSG_FILE" | grep -Ei "$SENSITIVE_WORDS" || true)

if [ -n "$MATCHES" ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  ⚠️  COMMIT BLOCKED: Sensitive words in commit message!${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "$MATCHES" | sed 's/^/  /'
    echo ""
    echo "Sensitive words are defined in: .sensitive-words"
    echo ""
    exit 1
fi

echo -e "${GREEN}✓ No sensitive words detected in commit message.${NC}"
exit 0
