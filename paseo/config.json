{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true
    },
    "browserTools": {
      "enabled": true
    },
    "autoArchiveAfterMerge": true,
    "enableTerminalAgentHooks": true,
    "appendSystemPrompt": "",
    "terminalProfiles": [
      {
        "id": "claude",
        "name": "Claude",
        "command": "claude",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "codex"
      },
      {
        "id": "opencode",
        "name": "OpenCode",
        "command": "opencode",
        "args": [
          "--prompt={{{prompt}}}"
        ],
        "icon": "opencode"
      },
      {
        "id": "pi",
        "name": "Pi",
        "command": "pi",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "pi"
      }
    ],
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "agents": {
    "providers": {
      "claude-work": {
        "extends": "claude",
        "label": "Claude (Work)",
        "env": {
          "CLAUDE_CONFIG_DIR": "~/.claude-work"
        }
      },
      "codex": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "opencode": {
        "enabled": false
      },
      "pi": {
        "enabled": false
      }
    }
  },
  "features": {
    "dictation": {
      "enabled": false
    },
    "voiceMode": {
      "enabled": false
    }
  }
}
