{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:registry.npmjs.org)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/Developer/dotfiles/claude/statusline-command.sh",
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "karaage-tools@karaage-dotfiles": true,
    "slack@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "crit@crit": true
  },
  "extraKnownMarketplaces": {
    "karaage-dotfiles": {
      "source": {
        "source": "directory",
        "path": "~/Developer/dotfiles/claude-marketplace"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.crit"
      ]
    },
    "excludedCommands": [
      "gh *",
      "/Users/yuki/Library/Caches/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-mac-arm64/chrome-headless-shell"
    ]
  },
  "awaySummaryEnabled": false,
  "editorMode": "vim",
  "remoteControlAtStartup": true
}
